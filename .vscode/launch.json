{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ClauseLens: Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "ClauseLens: CLI check (no UI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli.py",
      "args": ["sample/nasty_contract.txt"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
